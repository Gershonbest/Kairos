APP_NAME=Orheo Bookings API
APP_ENV=dev
APP_DEBUG=true
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/orheo
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300
JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_ORIGIN_REGEX=https://.*\.ngrok(-free)?\.app
PAYMENT_WEBHOOK_SECRET=change-me
# Paystack (https://dashboard.paystack.com/#/settings/developer)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Usually the same as PAYSTACK_SECRET_KEY (HMAC-SHA512 webhook verification).
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_PLATFORM_FEE_PERCENT=5.0
# Checkout methods shown to customers. OPay sits under "bank".
# Also enable the same channels in Paystack Dashboard → Settings → Preferences.
PAYSTACK_CHANNELS=card,bank,ussd,bank_transfer,qr
# Business paying Orheo (subscription). Origin or full /dashboard URL.
PAYSTACK_CALLBACK_URL_PLATFORM=http://localhost:5173/dashboard
# Client paying a business (booking). Include /book, same as PUBLIC_BOOKING_BASE_URL.
PAYSTACK_CALLBACK_URL_BOOKING=http://localhost:5173/book
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PUBLIC_BOOKING_BASE_URL=http://localhost:5173/book
FRONTEND_BASE_URL=http://localhost:5173
# Brevo HTTP API key (xkeysib-...). SMTP keys (xsmtpsib-...) go in SMTP_PASSWORD.
BREVO_API_KEY=
# SMS/WhatsApp provider for booking confirmations + reminders: brevo | termii
MESSAGING_PROVIDER=brevo
MESSAGING_DRY_RUN=true
# Brevo SMS/WhatsApp (used when MESSAGING_PROVIDER=brevo)
BREVO_SMS_SENDER=
BREVO_WHATSAPP_SENDER=
BREVO_WHATSAPP_TEMPLATE_CONFIRMATION=
BREVO_WHATSAPP_TEMPLATE_REMINDER=
# Termii SMS/WhatsApp (used when MESSAGING_PROVIDER=termii)
# Dashboard: https://accounts.termii.com/  Docs: https://developers.termii.com/messaging-api
TERMII_API_KEY=
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_SMS_SENDER=
TERMII_WHATSAPP_SENDER=
# dnd = transactional (recommended for bookings); generic = promotional
TERMII_SMS_CHANNEL=dnd
# Google Gmail SMTP (account email + 16-char app password).
# Create at https://myaccount.google.com/apppasswords (2FA required).
GOOGLE_GMAIL_SENDER=
GOOGLE_GMAIL_APP_PASSWORD=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=Orheo Bookings
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=60
EMAIL_VERIFICATION_REQUIRED=true
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1
GOOGLE_CLIENT_ID=
# AWS S3 media uploads (required when APP_ENV=production).
# Prefer bucket policy for public read; leave S3_OBJECT_ACL empty unless the bucket allows ACLs.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
S3_PUBLIC_BASE_URL=
S3_OBJECT_ACL=
# Local fallback when S3_BUCKET_NAME is empty (dev only).
LOCAL_UPLOAD_DIR=uploads
MEDIA_BASE_URL=http://localhost:8000/media
SUPER_ADMIN_EMAIL=admin@orheobookings.com
SUPER_ADMIN_PASSWORD=Admin123!
SUPER_ADMIN_NAME=System Admin
TRIAL_DAYS=7
TRIAL_WARNING_DAYS=2
# AI agents (LangChain + OpenAI). VECTOR_STORE_PROVIDER=pgvector|memory
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=0.2
VECTOR_STORE_PROVIDER=pgvector
AI_ENABLED=true
